<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <!-- 1. Header Row: Location & App Branding -->
    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Location Pin & City/District Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/widget_title"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_location_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="القاهرة"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- App Name Branding -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="أوقات صلاة"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 2. Middle Section: Elevated Card with Next Prayer & Live Countdown -->
    <LinearLayout
        android:id="@+id/widget_middle_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="7dp">

        <!-- Next Prayer Info (Start) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_next_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="الصلاة القادمة"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text="الظهر"
                android:textColor="@color/widget_text_gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text="12:53"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Chronometer Countdown (End) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="المتبقي"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="21sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/widget_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="@color/widget_text_gold"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Bottom Row: 5 Prayers Horizontally with Highlight -->
    <LinearLayout
        android:id="@+id/widget_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. Fajr -->
        <LinearLayout
            android:id="@+id/widget_col_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageView
                android:id="@+id/widget_icon_fajr"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_label_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:text="الفجر"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Dhuhr -->
        <LinearLayout
            android:id="@+id/widget_col_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageView
                android:id="@+id/widget_icon_dhuhr"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_label_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:text="الظهر"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Asr -->
        <LinearLayout
            android:id="@+id/widget_col_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageView
                android:id="@+id/widget_icon_asr"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_label_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:text="العصر"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Maghrib -->
        <LinearLayout
            android:id="@+id/widget_col_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageView
                android:id="@+id/widget_icon_maghrib"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_label_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:text="المغرب"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. Isha -->
        <LinearLayout
            android:id="@+id/widget_col_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageView
                android:id="@+id/widget_icon_isha"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_label_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:text="العشاء"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp"
                android:text="--:--"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
