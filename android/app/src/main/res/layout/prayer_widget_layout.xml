<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald_light"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Row 1: Location & Brand Wordmark -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_location_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_widget_location"
            android:contentDescription="الموقع" />

        <TextView
            android:id="@+id/widget_city_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="القاهرة"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="وِرد"
            android:textColor="@color/widget_accent_text"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Row 2: Compact Hero (2-line safe height for 4x2 launchers) -->
    <LinearLayout
        android:id="@+id/widget_middle_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Start Side: Next Prayer Name + Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical">

            <TextView
                android:id="@+id/widget_next_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="@color/widget_accent_text"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/widget_next_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المغرب"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_next_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="6:15"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- End Side: Live Chronometer Countdown -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/widget_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متبقي"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_accent_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:layoutDirection="ltr" />

            <TextView
                android:id="@+id/widget_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="--:--"
                android:textColor="@color/widget_accent_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline Divider -->
    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider"
        android:importantForAccessibility="no" />

    <!-- Row 3: Compact 5-Prayer Strip -->
    <LinearLayout
        android:id="@+id/widget_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/widget_col_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/widget_icon_fajr"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_fajr"
                android:contentDescription="الفجر" />

            <TextView
                android:id="@+id/widget_label_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="الفجر"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:30"
                android:textColor="@color/widget_text_primary"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/widget_col_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/widget_icon_dhuhr"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_dhuhr"
                android:contentDescription="الظهر" />

            <TextView
                android:id="@+id/widget_label_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="الظهر"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:05"
                android:textColor="@color/widget_text_primary"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/widget_col_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/widget_icon_asr"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_asr"
                android:contentDescription="العصر" />

            <TextView
                android:id="@+id/widget_label_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="العصر"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:30"
                android:textColor="@color/widget_text_primary"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/widget_col_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/widget_icon_maghrib"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_maghrib"
                android:contentDescription="المغرب" />

            <TextView
                android:id="@+id/widget_label_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="المغرب"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6:15"
                android:textColor="@color/widget_text_primary"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/widget_col_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/widget_icon_isha"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_isha"
                android:contentDescription="العشاء" />

            <TextView
                android:id="@+id/widget_label_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="العشاء"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:45"
                android:textColor="@color/widget_text_primary"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
